# ── Cynbit Smart Inquiry & Lead Management System ──
# Copy to .env.local for local dev. NEVER commit real secrets to GitHub.

# JWT signing secret — generate with: openssl rand -hex 32
# Must be at least 16 characters. Required in production.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Admin credentials (seeded into server/data/admins.json on first login
# or via: npx tsx scripts/seedAdmin.ts)
# Local dev defaults if unset: admin@cynbit.in / Admin@123
ADMIN_EMAIL=admin@cynbit.in
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Cynbit Admin

# Optional: public site URL (for emails/links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
